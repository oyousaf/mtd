---
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import PostCard from '@/components/PostCard.astro';
import CtaBand from '@/components/CtaBand.astro';

const posts = (await getCollection('blog')).sort((a, b) => +b.data.pubDate - +a.data.pubDate);
const [first, ...rest] = posts;
---
<Base
  title="Blog"
  description="Plain-English guides to Making Tax Digital, CIS and bookkeeping for builders, tradespeople and CIS subcontractors."
>
  <section class="relative overflow-hidden">
    <div class="blueprint absolute inset-0 [mask-image:radial-gradient(ellipse_at_top_left,black,transparent_70%)]" aria-hidden="true"></div>
    <div class="wrap relative pt-14 pb-12 lg:pt-20">
      <p class="eyebrow enter">The blog</p>
      <h1 style="--d:1" class="enter mt-5 max-w-4xl text-[clamp(2.6rem,6.5vw,5rem)] leading-[0.95] font-extrabold">MTD, CIS and bookkeeping, explained plainly</h1>
      <p style="--d:2" class="enter mt-6 max-w-2xl text-lg text-muted sm:text-xl">Straightforward guides for builders, tradespeople and CIS subcontractors getting ready for Making Tax Digital.</p>
    </div>
  </section>

  <section class="wrap pb-24">
    <div class="grid gap-x-6 gap-y-14 md:grid-cols-2 lg:grid-cols-3">
      <div class="md:col-span-2 lg:col-span-3"><PostCard post={first} featured /></div>
      {rest.map((post) => <PostCard post={post} />)}
    </div>
  </section>

  <CtaBand />
</Base>
