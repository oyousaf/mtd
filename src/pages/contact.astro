---
import { Calculator, Clock, Globe, HardHat, Mail, MapPin, Phone } from '@lucide/astro';
import Base from '@/layouts/Base.astro';
import EnquiryForm from '@/components/EnquiryForm.tsx';
import Checklist from '@/components/Checklist.astro';
import { site } from '@/data/site';

const audiences = [
  { icon: HardHat, title: 'Builders & tradespeople', text: 'Bookkeeping and MTD support for your self-employed business.' },
  { icon: Clock, title: 'CIS subcontractors', text: 'CIS deductions and MTD-ready bookkeeping records.' },
  { icon: Calculator, title: 'Accountants', text: 'Support for your clients who need MTD-ready bookkeeping.' },
  { icon: Globe, title: 'UK-wide support', text: 'Based in Uxbridge, helping clients across the UK.' },
];
---
<Base
  title="Contact"
  description="Get in touch with MTD Trade Books. Call 020 8191 3662 or send an enquiry to get set up for Making Tax Digital for a £20 one-off enrolment fee."
>
  <section class="relative overflow-hidden">
    <div class="blueprint absolute inset-0 [mask-image:radial-gradient(ellipse_at_top_left,black,transparent_70%)]" aria-hidden="true"></div>
    <div class="wrap relative pt-14 pb-10 lg:pt-20">
      <p class="eyebrow enter">Contact</p>
      <h1 style="--d:1" class="enter mt-5 max-w-4xl text-[clamp(2.6rem,6.5vw,5rem)] leading-[0.95] font-extrabold">Get in touch with MTD Trade Books</h1>
      <p style="--d:2" class="enter mt-6 max-w-2xl text-lg text-muted sm:text-xl">
        Whether you have a question, want to find out more about our services or are ready to get started, we’d love to hear from you.
      </p>
    </div>
  </section>

  <section class="wrap grid gap-4 pb-20 lg:grid-cols-12">
    <div id="enquiry" class="card scroll-mt-28 p-6 sm:p-10 lg:col-span-7">
      <p class="eyebrow">£20 enrolment</p>
      <h2 class="mt-4 text-3xl font-extrabold sm:text-4xl">Get started with MTD Trade Books</h2>
      <p class="mt-3 text-muted">
        Starting Making Tax Digital in April 2027? Complete our enquiry form and we’ll help you get set up with FreeAgent and your bookkeeping. The one-off enrolment fee is £20, with no monthly bookkeeping payments until April 2027.
      </p>
      <Checklist class="mt-6 text-sm sm:grid-cols-3" items={['Takes just a few minutes', 'Tells us what you need', 'We’ll reply as soon as possible']} />
      <div class="mt-8 border-t border-line pt-8">
        <EnquiryForm client:load email={site.email} />
      </div>
    </div>

    <aside class="grid content-start gap-4 lg:col-span-5">
      <a href={site.phoneHref} class="group rounded-[1.75rem] bg-orange p-7 text-ink transition hover:-translate-y-0.5">
        <Phone class="size-7" aria-hidden="true" />
        <p class="mt-6 font-mono text-xs tracking-[0.18em] uppercase">Call us</p>
        <p class="mt-1 font-display text-4xl font-extrabold tracking-tight">{site.phone}</p>
        <p class="mt-2 font-medium">{site.hours}</p>
        <p class="mt-3 text-sm text-ink/75">If we can’t answer, please leave a message and we’ll call you back.</p>
      </a>
      <a href={`mailto:${site.email}`} class="group rounded-[1.75rem] bg-ink p-7 text-plaster transition hover:-translate-y-0.5 dark:border dark:border-line">
        <Mail class="size-7 text-lime" aria-hidden="true" />
        <p class="mt-6 font-mono text-xs tracking-[0.18em] text-plaster/60 uppercase">Email us</p>
        <p class="mt-1 font-display text-xl font-bold break-all group-hover:text-lime sm:text-2xl">{site.email}</p>
        <p class="mt-3 text-sm text-plaster/65">We aim to reply within one working day.</p>
      </a>
      <div class="card blueprint p-7">
        <MapPin class="size-7 text-orange" aria-hidden="true" />
        <p class="mt-6 font-mono text-xs tracking-[0.18em] text-muted uppercase">Our location</p>
        <p class="mt-1 font-display text-2xl font-bold">{site.location}</p>
        <p class="mt-2 text-sm text-muted">Supporting clients across the UK.</p>
      </div>
    </aside>
  </section>

  <section class="wrap pb-8">
    <h2 class="sr-only">Who we help</h2>
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {audiences.map(({ icon: Icon, title, text }) => (
        <li class="reveal card p-6">
          <Icon class="size-7 text-orange" aria-hidden="true" />
          <h3 class="mt-5 text-lg font-bold">{title}</h3>
          <p class="mt-1 text-sm text-muted">{text}</p>
        </li>
      ))}
    </ul>
  </section>
</Base>
