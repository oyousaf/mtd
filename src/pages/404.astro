---
import Base from '@/layouts/Base.astro';
---
<Base title="Page not found" description="This page could not be found.">
  <section class="wrap blueprint grid min-h-[60vh] place-items-center py-24 text-center">
    <div>
      <p class="mono-num text-[clamp(6rem,20vw,12rem)] leading-none font-medium text-orange">404</p>
      <h1 class="mt-4 text-4xl font-extrabold">This page has gone off-site</h1>
      <p class="mt-4 text-lg text-muted">The page you’re after doesn’t exist or has moved.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="/" class="btn-primary">Back to home</a>
        <a href="/contact" class="btn-ghost">Contact us</a>
      </div>
    </div>
  </section>
</Base>
