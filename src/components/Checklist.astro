---
import { Check } from '@lucide/astro';
interface Props { items: string[]; class?: string; tone?: 'lime' | 'orange' }
const { items, class: className = '', tone = 'lime' } = Astro.props;
---
<ul class:list={['grid gap-3', className]}>
  {items.map((item) => (
    <li class="flex gap-3">
      <span class:list={['mt-0.5 grid size-5 shrink-0 place-items-center rounded-full text-ink', tone === 'lime' ? 'bg-lime' : 'bg-orange']}>
        <Check class="size-3" stroke-width={3} aria-hidden="true" />
      </span>
      <span>{item}</span>
    </li>
  ))}
</ul>
