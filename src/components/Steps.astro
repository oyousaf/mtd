---
import SectionHeading from './SectionHeading.astro';
interface Props { eyebrow?: string; title: string; lede?: string; steps: { title: string; text: string }[] }
const { eyebrow, title, lede, steps } = Astro.props;
---
<section class="wrap py-20 lg:py-28">
  <SectionHeading eyebrow={eyebrow} title={title} lede={lede} />
  <ol class:list={['mt-12 grid gap-4 sm:grid-cols-2', steps.length > 4 ? 'lg:grid-cols-5' : 'lg:grid-cols-4']}>
    {steps.map((step, i) => (
      <li class="reveal card group relative flex flex-col overflow-hidden p-6 transition duration-500 ease-out-expo hover:-translate-y-1 hover:border-orange/60">
        <span class="mono-num text-5xl font-medium text-orange/90">{String(i + 1).padStart(2, '0')}</span>
        <span class="absolute top-9 right-6 left-24 h-px bg-line" aria-hidden="true"></span>
        <h3 class="mt-8 text-xl font-bold">{step.title}</h3>
        <p class="mt-2 text-sm leading-relaxed text-muted">{step.text}</p>
      </li>
    ))}
  </ol>
</section>
