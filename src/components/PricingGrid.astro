---
import { ArrowRight, Check } from '@lucide/astro';
import { plans as allPlans } from '@/data/site';
interface Props { only?: string[] }
const { only } = Astro.props;
const plans = only ? allPlans.filter((p) => only.includes(p.id)) : allPlans;
---
<div class:list={['grid gap-4 sm:grid-cols-2', plans.length > 2 && 'xl:grid-cols-4']}>
  {plans.map((plan) => (
    <article
      class:list={[
        'reveal group relative flex flex-col rounded-[1.75rem] border p-7 transition duration-500 ease-out-expo hover:-translate-y-1',
        plan.featured ? 'border-ink bg-ink text-plaster dark:border-lime/40' : 'border-line bg-surface hover:border-orange/60',
      ]}
    >
      {plan.badge && (
        <span class="absolute -top-3 left-7 rounded-full bg-lime px-3 py-1 font-mono text-[0.65rem] font-semibold tracking-wider text-ink uppercase">{plan.badge}</span>
      )}
      <h3 class="text-lg font-bold">{plan.name}</h3>
      <p class:list={['mt-6 flex items-baseline gap-1.5', plan.featured ? 'text-lime' : 'text-fg']}>
        {plan.from && <span class="text-sm font-medium opacity-70">from</span>}
        <span class="mono-num text-6xl font-medium">£{plan.price}</span>
      </p>
      <p class:list={['font-mono text-xs tracking-wider uppercase', plan.featured ? 'text-plaster/60' : 'text-muted']}>{plan.unit}</p>
      <p class:list={['mt-5 text-sm', plan.featured ? 'text-plaster/75' : 'text-muted']}>{plan.blurb}</p>
      <ul class:list={['mt-6 grid gap-2.5 border-t pt-6 text-sm', plan.featured ? 'border-plaster/15' : 'border-line']}>
        {plan.features.map((f) => (
          <li class="flex gap-2.5"><Check class:list={['mt-0.5 size-4 shrink-0', plan.featured ? 'text-lime' : 'text-orange']} stroke-width={3} aria-hidden="true" />{f}</li>
        ))}
      </ul>
      <a href={plan.id === 'enrol' ? '/contact#enquiry' : '/contact'} class:list={['mt-8', plan.featured ? 'btn-primary' : 'btn-ghost']}>
        {plan.id === 'enrol' ? 'Enrol for £20' : 'Get started'} <ArrowRight class="size-4" aria-hidden="true" />
      </a>
    </article>
  ))}
</div>
