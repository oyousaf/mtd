---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import SectionHeading from './SectionHeading.astro';
import PricingGrid from './PricingGrid.astro';
import Checklist from './Checklist.astro';

interface Props { title: string; intro: string; included: string[]; image: ImageMetadata; imageAlt: string }
const { title, intro, included, image, imageAlt } = Astro.props;
---
<section class="border-y border-line bg-surface py-20 lg:py-28">
  <div class="wrap grid gap-12 lg:grid-cols-12">
    <div class="lg:col-span-5">
      <SectionHeading eyebrow="Our approach" title={title} lede={intro} />
      <div class="reveal mt-8 overflow-hidden rounded-[1.75rem] border border-line">
        <Image src={image} alt={imageAlt} widths={[640, 960]} sizes="(min-width: 1024px) 40vw, 100vw" class="aspect-[16/10] w-full object-cover object-right" />
      </div>
    </div>
    <div class="grid gap-4 lg:col-span-7">
      <PricingGrid only={['monthly', 'catchup']} />
      <div class="reveal rounded-[1.75rem] border border-line bg-bg p-7 sm:p-8">
        <h3 class="text-2xl font-extrabold">What’s included</h3>
        <Checklist items={included} class="mt-6 sm:grid-cols-2" tone="orange" />
      </div>
    </div>
  </div>
</section>
